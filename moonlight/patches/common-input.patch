diff --git a/src/InputStream.c b/src/InputStream.c
index 5994836..cefdf64 100644
--- a/src/InputStream.c
+++ b/src/InputStream.c
@@ -1636,3 +1636,20 @@ int LiSendControllerBatteryEvent(uint8_t controllerNumber, uint8_t batteryState,
 
     return err;
 }
+
+// 与普通输入共用有界队列和控制流加密；负载不包含任意远程命令。
+int LiSendPadInput(const char* data, unsigned int length) {
+    if (!initialized) return -2;
+    if (!encryptedControlStream || !(SunshineFeatureFlags & PAD_FEATURE_FLAG)) return LI_ERR_UNSUPPORTED;
+    if (!data || length == 0 || length > PAD_PAYLOAD_MAX) return -1;
+    PPACKET_HOLDER holder = allocatePacketHolder((int)length);
+    if (!holder) return -1;
+    holder->channelId = CTRL_CHANNEL_MOUSE;
+    holder->enetPacketFlags = ENET_PACKET_FLAG_RELIABLE;
+    holder->packet.unicode.header.size = BE32(sizeof(uint32_t) + length);
+    holder->packet.unicode.header.magic = LE32(PAD_INPUT_MAGIC);
+    memcpy(holder->packet.unicode.text, data, length);
+    int result = LbqOfferQueueItem(&packetQueue, holder, &holder->entry);
+    if (result != LBQ_SUCCESS) freePacketHolder(holder);
+    return result;
+}
