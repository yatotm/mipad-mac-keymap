+// 回调只复制有界元数据，界面更新由 Java 主线程处理。
+void BridgeClPadState(const char* data, int length) {
+    JNIEnv* env = GetThreadEnv();
+    if (!data || length <= 0 || length > PAD_STATE_MAX) return;
+    jbyteArray bytes = (*env)->NewByteArray(env, length);
+    if (!bytes) return;
+    (*env)->SetByteArrayRegion(env, bytes, 0, length, (const jbyte*)data);
+    (*env)->CallStaticVoidMethod(env, GlobalBridgeClass, BridgeClPadStateMethod, bytes);
+    (*env)->DeleteLocalRef(env, bytes);
+    if ((*env)->ExceptionCheck(env)) (*env)->ExceptionClear(env);
+}
