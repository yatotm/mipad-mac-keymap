+JNIEXPORT jint JNICALL
+Java_com_limelight_nvstream_jni_MoonBridge_sendPadInput(JNIEnv *env, jclass clazz, jbyteArray bytes) {
+    if (!bytes) return -1;
+    jsize length = (*env)->GetArrayLength(env, bytes);
+    if (length <= 0 || length > PAD_PAYLOAD_MAX) return -1;
+    char data[PAD_PAYLOAD_MAX];
+    (*env)->GetByteArrayRegion(env, bytes, 0, length, (jbyte*)data);
+    if ((*env)->ExceptionCheck(env)) return -1;
+    return LiSendPadInput(data, (unsigned int)length);
+}
