@@ -0,0 +1,35 @@
+/**
+ * @file src/platform/macos/pad_cursor.h
+ * @brief 根据有时效的本地光标状态决定是否录制服务端箭头。
+ */
+#import <Foundation/Foundation.h>
+#include <signal.h>
+#include <limits.h>
+
+/**
+ * @brief 只在 Helper 在线且状态新鲜时关闭视频里的重复光标。
+ * @param path Helper 覆盖写入的状态文件。
+ * @param now 当前时间，用于拒绝旧状态和未来时间。
+ * @return 本地光标是否有效；缺失、异常或失联均回退到视频光标。
+ */
+static BOOL pad_local_cursor_active(NSString *path, NSDate *now) {
+  NSDictionary *attrs = [[NSFileManager defaultManager] attributesOfItemAtPath:path error:NULL];
+  NSDate *modified = attrs[NSFileModificationDate];
+  if (modified == nil || [attrs[NSFileSize] unsignedLongLongValue] > 4096) {
+    return NO;
+  }
+  NSTimeInterval age = [now timeIntervalSinceDate:modified];
+  if (age < -1 || age > 3.5) {
+    return NO;
+  }
+  NSData *data = [NSData dataWithContentsOfFile:path];
+  id status = data ? [NSJSONSerialization JSONObjectWithData:data options:0 error:NULL] : nil;
+  if (![status isKindOfClass:[NSDictionary class]] ||
+      ![status[@"local_cursor"] isEqual:@YES] ||
+      ![status[@"moonlight_connection"] isEqual:@"connected"] ||
+      ![status[@"pid"] isKindOfClass:[NSNumber class]]) {
+    return NO;
+  }
+  long long pid = [status[@"pid"] longLongValue];
+  return pid > 0 && pid <= INT_MAX && kill((pid_t) pid, 0) == 0;
+}
